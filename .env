## Image versions ##
# renovate: datasource=docker depName=camunda/camunda
CAMUNDA_VERSION=8.9.19
CAMUNDA_CONNECTORS_VERSION=8.9.10
CAMUNDA_IDENTITY_VERSION=8.9.9
CAMUNDA_OPERATE_VERSION=8.9.11
CAMUNDA_OPTIMIZE_VERSION=8.9.19
CAMUNDA_TASKLIST_VERSION=8.9.11
CAMUNDA_WEB_MODELER_VERSION=8.9.8
CAMUNDA_CONSOLE_VERSION=8.9.104
ELASTIC_VERSION=8.19.11
KEYCLOAK_SERVER_VERSION=quay-26.6.4
MAILPIT_VERSION=v1.21.8
POSTGRES_VERSION=15-alpine3.22

## Network Configuration ##
HOST=camunda.dev.local
KEYCLOAK_HOST=keycloak

## Stage / Environment Label ##
STAGE=PROD
DISPLAY_STAGE=BBC-TEST
## Dashboard Banner ##
BANNER_DARKMODE=/banner-darkmode.png
BANNER_LIGHTMODE=/banner-lightmode.svg

## Backup Configuration ##
BACKUP_STOP_TIMEOUT=180
ES_HOST=localhost
ES_PORT=9200
RESTORE_HEALTH_TIMEOUT=300
#ES_BACKUP_VOLUME=elastic-backup
#BACKUP_BASE_DIR=backups

## TLS Certificates (Optional) ##
FULLCHAIN_PEM=/certs/_wildcard.camunda.dev.local+1.pem
PRIVATEKEY_PEM=/certs/_wildcard.camunda.dev.local+1-key.pem

## Camunda Private Registry Endpoint ##
# Public Harbor URL. Credentials (CAMUNDA_REGISTRY_USERNAME / PASSWORD) live
# in .env-credentials so they stay out of git.
CAMUNDA_REGISTRY_URL=https://registry.camunda.cloud

## Feature Flags ##
RESOURCE_AUTHORIZATIONS_ENABLED=true

## Web Modeler Mail (Optional) ##
WEBMODELER_MAIL_FROM_ADDRESS=noreply@camunda.example.com

## Monitor Configuration (Optional) ##
# Override defaults used by scripts/monitor.sh and scripts/monitor.ps1.
#MONITOR_LOG_FILE=monitor.log
#MONITOR_LOG_MAX_SIZE=10485760
#MONITOR_LOG_MAX_ARCHIVES=5
CAMUNDA_IMAGE=registry.camunda.cloud/hotfixes-ee/camunda:8.9.19-secfix
CAMUNDA_CONNECTORS_IMAGE=registry.camunda.cloud/hotfixes-ee/connectors-bundle:8.9.10-secfix
WEBMODELER_RESTAPI_IMAGE=registry.camunda.cloud/hotfixes-ee/modeler-restapi:8.9.8-secfix
WEBMODELER_WEBSOCKETS_IMAGE=registry.camunda.cloud/hotfixes-ee/modeler-websockets:8.9.8-secfix
