es:
  settings:
    index:
      number_of_shards: 1
      number_of_replicas: 0
      nested_documents_limit: 80000
  security:
    username: elastic
    password: "ELASTIC_PASSWORD_PLACEHOLDER"
zeebe:
  enabled: true
  name: zeebe-record
  partitionCount: 1
  # 8.10 stopped flattening object variables by default in Self-Managed.
  # Keep the 8.9 behavior so existing reports/filters on object variable
  # properties (e.g. customer.name) keep working. Set to false once no report
  # depends on flattened object variables.
  includeObjectVariableValue: true
enterprise: false
ui:
  logoutHidden: true
import:
  skipDataAfterNestedDocLimitReached: true
historyCleanup:
  cronTrigger: 0 1 * * *
  ttl: P365D
  processDataCleanup:
    enabled: true
