es:
  settings:
    index:
      number_of_shards: 1
      number_of_replicas: 0
      nested_documents_limit: 80000
  security:
    username: elastic
    password: "ELASTIC_PASSWORD_PLACEHOLDER"
zeebe:
  enabled: true
  name: zeebe-record
  partitionCount: 1
enterprise: false
security:
  auth:
    cookie:
      same-site:
        enabled: false
ui:
  logoutHidden: true
import:
  skipDataAfterNestedDocLimitReached: true
historyCleanup:
  cronTrigger: 0 1 * * *
  ttl: P365D
  processDataCleanup:
    enabled: true

# Secure the Optimize public REST API against the local Keycloak.
# Tokens must carry the optimize-api audience (Optimize API in Management Identity).
api:
  jwtSetUri: http://keycloak:18080/auth/realms/camunda-platform/protocol/openid-connect/certs
  audience: optimize-api

# Send alert notifications via the bundled Mailpit SMTP server.
# Replace hostname/port to use your own SMTP server.
email:
  enabled: true
  address: optimize@camunda.example.com
  hostname: mailpit
  port: 1025
