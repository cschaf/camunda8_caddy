flowchart LR
    subgraph clients[" "]
        direction TB
        browser["🖥️ Web UI / API<br/>Browser<br/><i>Identity, Console, Web Modeler,<br/>Operate, Tasklist, Optimize</i>"]
        userapp["⚙️ User Application<br/>Camunda Client<br/>API / gRPC"]
    end

    subgraph vm1["🐳 VM 1 — Docker Host: Camunda 8.9 Cluster"]
        direction TB

        caddy["🔀 Reverse Proxy<br/><b>Caddy</b> · HTTPS :443<br/><i>Subdomains (jeweils .{HOST}):<br/>keycloak · identity · console<br/>orchestration · optimize<br/>webmodeler · zeebe</i>"]

        subgraph apps["Camunda Services (Docker Network: camunda-platform)"]
            direction TB
            console["Console"]
            webmodeler["Web Modeler<br/><i>REST API + WebSockets</i>"]
            identity["Management Identity"]
            optimize["Optimize"]
            orchestration["Orchestration Cluster<br/><b>Zeebe + Operate + Tasklist</b><br/>gRPC :26500 · REST/UI :8080"]
            connectors["Connectors<br/><i>(out-of-the-box)</i>"]
        end

        subgraph infra["Infrastruktur (Container)"]
            direction TB
            keycloak["Authentication<br/><b>Keycloak (OIDC)</b>"]
            postgres["SQL Database<br/><b>PostgreSQL</b><br/><i>Identity + Web Modeler DB</i>"]
            elastic["NoSQL Database<br/><b>Elasticsearch</b>"]
            mailpit["Mailpit<br/><i>SMTP (Web Modeler)</i>"]
        end

        caddy --> console
        caddy --> webmodeler
        caddy --> identity
        caddy --> optimize
        caddy --> orchestration
    end

    subgraph vm2["🐳 VM 2 — Docker Host: Eigene Konnektoren"]
        customconn["Custom Connectors<br/><i>eigene Connector-Runtime</i>"]
    end

    browser -->|"HTTPS :443"| caddy
    userapp -->|"gRPC :26500 / HTTPS"| caddy

    identity -.->|"OIDC"| keycloak
    webmodeler -.->|"OIDC"| keycloak
    console -.->|"OIDC"| keycloak
    optimize -.->|"OIDC"| keycloak
    orchestration -.->|"OIDC / Token"| keycloak

    identity -.-> postgres
    webmodeler -.-> postgres
    webmodeler -.-> mailpit

    orchestration -.->|"Exporter"| elastic
    optimize -.-> elastic

    connectors -->|"gRPC"| orchestration
    customconn ==>|"gRPC :26500<br/>via zeebe.{HOST}"| caddy
    caddy -->|"h2c"| orchestration

    classDef vm fill:#f4f4f4,stroke:#888,stroke-width:2px
    classDef svc fill:#dbeafe,stroke:#3b82f6
    classDef infraBox fill:#e5e7eb,stroke:#374151
    classDef proxy fill:#fef3c7,stroke:#d97706
    class vm1,vm2 vm
    class console,webmodeler,identity,optimize,orchestration,connectors,customconn svc
    class keycloak,postgres,elastic,mailpit infraBox
    class caddy proxy
